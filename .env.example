# Copy to `.env` in the repo root and fill in values (never commit `.env`).
# See SETUP.md for where to obtain each credential.

# --- Required for Google Places extraction ---
GOOGLE_PLACES_API_KEY=

# --- Exa (optional; pipeline skips Exa if empty) ---
EXA_API_KEY=

# --- NoBroker (optional; improves listing / phone resolution) ---
# Single line: Cookie header string from an authenticated browser session.
NOBROKER_COOKIES_RAW=

# --- Numverify HLR (optional) ---
NUMVERIFY_API_KEY=

# --- Twilio Lookup (optional alternative to Numverify) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# --- WhatsApp Business Cloud API (optional) ---
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_ID=
